{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia-harness.local/contracts/audit/audit_event.json",
  "title": "AuditEvent",
  "description": "Contrato da trilha de auditoria: um evento por chamada de modelo e por execução/negativa de tool, sempre redigido/truncado. Fonte única do AuditSink.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "trace_id", "user_id", "session_id", "agent_id", "status", "estimated", "latency_ms", "occurred_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["model_call", "tool_call"] },
    "trace_id": { "type": "string" },
    "user_id": { "type": "string" },
    "session_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "tool": { "type": "string" },
    "tool_call_id": { "type": "string" },
    "status": { "enum": ["ok", "error", "denied", "awaiting_confirmation"] },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": "integer", "minimum": 0 },
    "cache_write_tokens": { "type": "integer", "minimum": 0 },
    "estimated": { "type": "boolean" },
    "cost_micros": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "args_redacted": { "type": "string" },
    "result_redacted": { "type": "string" },
    "error": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
