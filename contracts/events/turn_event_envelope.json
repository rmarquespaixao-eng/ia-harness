{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia-harness.local/contracts/events/turn_event_envelope.json",
  "title": "TurnEventEnvelope",
  "description": "Envelope de evento do turno para hosts que transmitem os eventos ao cliente (ex.: SSE da UI do financeiro). Complementa, como contrato de fio, os tipos Go do Handler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "session_id", "at"],
  "properties": {
    "type": { "enum": ["text_delta", "tool_call", "tool_result", "progress", "confirmation_required", "usage", "error", "turn_finished"] },
    "session_id": { "type": "string", "minLength": 1 },
    "message_id": { "type": "string" },
    "call_id": { "type": "string" },
    "tool": { "type": "string" },
    "namespace": { "type": "string" },
    "text": { "type": "string" },
    "args_redacted": { "type": "string" },
    "args_bytes": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["ok", "error", "denied"] },
    "is_error": { "type": "boolean" },
    "denied": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "result_summary": { "type": "string" },
    "progress": { "type": "number" },
    "total": { "type": "number" },
    "progress_message": { "type": "string" },
    "reason": { "type": "string" },
    "decision": { "enum": ["approve", "deny"] },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "estimated": { "type": "boolean" },
    "cost_micros": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "scope": { "enum": ["model", "tool", "mcp"] },
    "error": { "type": "string" },
    "retryable": { "type": "boolean" },
    "stop_reason": { "enum": ["completed", "max_iterations", "budget", "cancelled", "error"] },
    "at": { "type": "string", "format": "date-time" }
  }
}
